{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "USB-IP-Bridge",
  "identifier": "com.github.helge666.usb-ip-bridge",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "USB-IP-Bridge",
        "width": 820,
        "height": 640,
        "minWidth": 520,
        "minHeight": 400,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Helge666",
    "homepage": "https://github.com/Helge666/USB-IP-Bridge",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "category": "Utility",
    "shortDescription": "Use USB devices of another computer over the network",
    "longDescription": "USB-IP-Bridge lets computers in your network use each other's USB devices as if they were plugged in locally - audio interfaces, MIDI interfaces, cameras, drives. It runs as a background service and has a simple app to share, use and give devices.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
