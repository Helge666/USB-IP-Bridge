{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../packaging/windows/prepare-bundle.ps1"
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "../../target/release/usbipb-service.exe": "usbipb-service.exe",
      "../../target/release/usbipb.exe": "usbipb.exe",
      "../../target/bundle-extra/usbipd-win.msi": "usbipd-win.msi",
      "../../target/bundle-extra/usbip-win2-setup.exe": "usbip-win2-setup.exe",
      "../../target/bundle-extra/THIRD-PARTY.txt": "THIRD-PARTY.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "../../packaging/windows/installer-hooks.nsh",
        "languages": ["English", "German"],
        "displayLanguageSelector": false
      }
    }
  }
}
